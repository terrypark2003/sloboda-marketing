# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real keys.

# --- 필수 ---
# Telegram bot token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# LLM 제공사: gemini (기본, 저렴) 또는 anthropic
CMO_PROVIDER=gemini

# Google Gemini API key — https://aistudio.google.com/apikey  (CMO_PROVIDER=gemini일 때 필요)
GEMINI_API_KEY=AIza...

# 팀만 사용하도록 제한 (권장). 콤마로 구분한 chat ID. 비우면 누구나 사용 가능.
# 봇에 /id 를 보내면 본인 chat ID를 알 수 있어요.
# CMO_ALLOWED_CHAT_IDS=123456789,987654321

# --- Anthropic(Claude)로 쓸 때만 필요 (CMO_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- optional overrides (defaults shown) ---
# CMO_GEMINI_MODEL=gemini-2.5-flash      # 더 저렴/무료티어: gemini-2.5-flash-lite
# CMO_MODEL=claude-opus-4-8              # anthropic일 때 모델
# CMO_MAX_TOKENS=8000
# CMO_ENABLE_WEB_SEARCH=true             # 실시간 시장조사(검색) 사용
# CMO_ENABLE_THINKING=true               # 추론 사용 (false면 비용↓)
# CMO_HISTORY_MAX_MESSAGES=24
# CMO_REQUEST_TIMEOUT=300
