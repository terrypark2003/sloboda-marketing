# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real keys.

# Telegram bot token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Anthropic API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Restrict the bot to your team (recommended — protects your API budget).
# Comma-separated Telegram chat IDs. Leave empty/unset = anyone can use the bot.
# Get an ID by sending /id to the bot.
# CMO_ALLOWED_CHAT_IDS=123456789,987654321

# --- optional overrides (defaults shown) ---
# CMO_MODEL=claude-opus-4-8
# CMO_MAX_TOKENS=8000
# CMO_ENABLE_WEB_SEARCH=true
# CMO_ENABLE_THINKING=true
# CMO_HISTORY_MAX_MESSAGES=24
# CMO_REQUEST_TIMEOUT=300
